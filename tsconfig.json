{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,

    // Incremental migration: JS is allowed but not type-checked. Each file
    // renamed to .ts / .tsx opts into `strict`. Remove `checkJs: false` (or
    // flip to true) once the tree is mostly .ts. See docs/ARCHITECTURE.md.
    "allowJs": true,
    "checkJs": false,

    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
